// ============================================================================
// HOLYSYNTH - demo package: a HolyQ program that runs in a PMP cell and
// uses the cell RPCs (print, beep, sleep). Beeps are silent on builds
// without an audio driver.
// ============================================================================

extern U0 kprintf(U8* fmt, ...);
extern U0 speaker_event(U32 event_id);
extern U0 SleepMS(U32 ms);

U0 PlayHolyChords() {
    kprintf("=================================================================\n");
    kprintf("  [ HOLYSYNTH v1.0 ] Demo package: print, beep and sleep RPCs    \n");
    kprintf("  Running in a PMP cell on RISC-V 64-bit bare metal              \n");
    kprintf("=================================================================\n");
    
    kprintf("Requesting three beeps from the kernel...\n");
    speaker_event(1);
    SleepMS(80);
    speaker_event(3);
    SleepMS(120);
    speaker_event(4);
    
    kprintf("Done.\n");
    kprintf("=================================================================\n");
}

PlayHolyChords();
